# Supabase project — the NEW dedicated project shared by mcfabs-site and
# mcfabs-admin ONLY. Do NOT use the ticketing platform's Supabase credentials.
#
# This app only ever uses the anon/public key. Never put a service-role key
# in this file or anywhere in this codebase.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public site origin (used to build canonical/OG URLs). Set to the deployed
# Render URL in production.
VITE_SITE_URL=https://mcfabs.onrender.com

# External ticketing platform — plain hyperlink target only, no API/DB
# integration. Point this at a specific event URL if the platform supports
# deep links; otherwise leave as the homepage.
VITE_TICKETING_URL=https://fabs-masterclass.onrender.com
