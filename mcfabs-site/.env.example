VITE_BOOKING_EMAIL=
# Country code and number, digits only.
VITE_WHATSAPP_NUMBER=
# Optional verified profiles; unset profiles are hidden.
VITE_INSTAGRAM_URL=
VITE_X_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=
